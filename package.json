{
  "name": "nova-media-player",
  "version": "1.0.0",
  "description": "NOVA MEDIA PLAYER — nowoczesny odtwarzacz muzyki i filmów dla Windows",
  "main": "src/main.js",
  "author": "NOVA",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/library.js && node --check ui/app.js && npm test",
    "build:windows": "electron-builder --win nsis --win portable --x64 --publish never",
    "build:dir": "electron-builder --win dir --x64 --publish never",
    "prestart": "node scripts/generate-icons.js",
    "prebuild:windows": "node scripts/generate-icons.js",
    "prebuild:dir": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nova.mediaplayer",
    "productName": "NOVA MEDIA PLAYER",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NOVA MEDIA PLAYER",
      "artifactName": "NOVA-MEDIA-PLAYER-1.0-SETUP-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "NOVA-MEDIA-PLAYER-1.0-PORTABLE-${arch}.${ext}"
    }
  }
}
